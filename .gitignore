# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs
# Собранный отчет сдается вместе с репозиторием, поэтому docs/ целиком
# не игнорируется. Исключаем только то, что пересобирается локально.
node_modules/
docs/.build/
docs/*.tmp
*.log

# Dotenv file
.env
.env.*
!.env.example

# macOS
.DS_Store
